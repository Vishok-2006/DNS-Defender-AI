# Copy to .env and edit.   cp .env.example .env
# ---- Required ---------------------------------------------------------------
# Generate with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- Optional ---------------------------------------------------------------
POSTGRES_USER=dnsdefender
POSTGRES_DB=dns_defender

# Protects every API route (except /health) and the WebSockets. Strongly recommended
# when the dashboard is reachable from your LAN. Leave empty to disable.
API_KEY=

# DNS resolver
DNS_UPSTREAM_SERVERS=1.1.1.1,8.8.8.8
DNS_PORT=53                 # use 5353 for development on a machine that already runs a resolver
DNS_BIND_IP=0.0.0.0         # set to the Pi's LAN IP to avoid listening on every interface

# Ports
UI_PORT=3000
BACKEND_BIND=127.0.0.1

# Response policy: alert-only unless you explicitly opt in to automatic blocking
ALERT_ONLY_MODE=true
AUTO_BLOCK_CONFIRMED=false
RETENTION_DAYS=7

# Optional LLM threat explanations (NVIDIA NIM). Without a key, offline explanations are used.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
CORS_ORIGINS=http://localhost:3000
